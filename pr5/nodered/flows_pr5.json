    {
        "id": "fn_validate_v3",
        "type": "function",
        "z": "tab_pr5_v3",
        "name": "Перевірка даних (h: 0..300)",
        "func": "const station = msg.topic.split(\"/\")[2];\nconst d = msg.payload;\n\nconst ok = (v, lo, hi) => typeof v === \"number\" && !Number.isNaN(v) && v >= lo && v <= hi;\nconst errors = [];\n\nif (!ok(d.h, 0, 300)) errors.push(\"h\");\nif (!Number.isInteger(d.ts)) errors.push(\"ts\");\n\nif (errors.length > 0) {\n    const n = (context.get(\"rejected\") || 0) + 1;\n    context.set(\"rejected\", n);\n    node.status({ fill: \"red\", shape: \"dot\", text: `відхилено: ${n}` });\n    msg.payload = { station, errors, raw: d };\n    return [null, msg];\n}\n\nmsg.station = station;\nmsg.ts = d.ts;\nmsg.payload = { h: d.h };\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 100,
        "wires": [
            [
                "fn_calc_v3"
            ],
            [
                "dbg_rejected_v3"
            ]
        ]
    },
    {
        "id": "fn_calc_v3",
        "type": "function",
        "z": "tab_pr5_v3",
        "name": "Швидкість v, EMA і тривога",
        "func": "const ALPHA_H = 0.3;\nconst ALPHA_V = 0.25;\nconst ON = 150.0;\nconst OFF = 120.0;\n\nconst key = \"st_\" + msg.station;\nconst st = context.get(key) || {\n    prev_h: null,\n    prev_ts: null,\n    h_ema: null,\n    v_ema: null,\n    alarm: 0\n};\n\nconst h = msg.payload.h;\nconst ts = msg.ts;\n\n// Швидкість зміни рівня v_t = (h_t - h_{t-1}) / dt * 60 (см/хв)\nlet v = 0.0;\nif (st.prev_h !== null && st.prev_ts !== null && ts > st.prev_ts) {\n    const dt_sec = (ts - st.prev_ts) / 1000.0;\n    v = ((h - st.prev_h) / dt_sec) * 60.0;\n}\n\n// Згладжування рівня (EMA) та швидкості (EMA)\nst.h_ema = st.h_ema === null ? h : ALPHA_H * h + (1 - ALPHA_H) * st.h_ema;\nst.v_ema = st.v_ema === null ? v : ALPHA_V * v + (1 - ALPHA_V) * st.v_ema;\n\nst.prev_h = h;\nst.prev_ts = ts;\n\n// Тривога з гістерезисом за згладженим рівнем h_ema\nconst before = st.alarm;\nif (st.alarm === 0 && st.h_ema >= ON) st.alarm = 1;\nif (st.alarm === 1 && st.h_ema <= OFF) st.alarm = 0;\n\ncontext.set(key, st);\n\nmsg.payload.h_ema = Math.round(st.h_ema * 10) / 10;\nmsg.payload.v = Math.round(v * 100) / 100;\nmsg.payload.v_ema = Math.round(st.v_ema * 100) / 100;\nmsg.payload.alarm = st.alarm;\n\nlet alarmMsg = null;\nif (st.alarm !== before) {\n    alarmMsg = {\n        topic: `kharkiv/drains/${msg.station}/alarm`,\n        payload: JSON.stringify({\n            ts: msg.ts,\n            alarm: st.alarm,\n            h_ema: msg.payload.h_ema,\n            v_ema: msg.payload.v_ema\n        })\n    };\n}\n\nreturn [msg, alarmMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 100,
        "wires": [
            [
                "fn_params_v3"
            ],
            [
                "mqtt_out_alarm_v3",
                "dbg_alarm_v3"
            ]
        ]
    },
    {
        "id": "fn_params_v3",
        "type": "function",
        "z": "tab_pr5_v3",
        "name": "Параметри запиту SQL",
        "func": "const p = msg.payload;\nmsg.params = [\n    msg.ts,\n    msg.station,\n    p.h,\n    p.h_ema,\n    p.v,\n    p.v_ema,\n    p.alarm,\n    Date.now() - msg.ts\n];\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
        "y": 80,
        "wires": [
            [
                "pg_insert_drains"
            ]
        ]
    },
    {
        "id": "pg_insert_drains",
        "type": "postgresql",
        "z": "tab_pr5_v3",
        "name": "PostgreSQL: виміри",
        "query": "INSERT INTO storm_drains (ts, station, h, h_ema, v, v_ema, alarm, lag_ms)\nVALUES (to_timestamp($1 / 1000.0), $2, $3, $4, $5, $6, $7, $8)\nON CONFLICT (station, ts) DO NOTHING;",
        "postgreSQLConfig": "pg_config_pr5",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 1160,
        "y": 80,
        "wires": [
